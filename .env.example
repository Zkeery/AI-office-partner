# 业务配置模板。复制为项目根目录 .env 后填写。勿提交真实密钥。
# 复制：cp .env.example .env

# --- 本机端口 ---
# 后端 8040 / 前端 3040（与 frontend `next dev -p 3040` 一致）
APP_HOST=127.0.0.1
APP_PORT=8040
FRONTEND_ORIGIN=http://127.0.0.1:3040

# 运行时数据目录。推荐在 backend/ 下启动 uvicorn，则 ./data → backend/data/
# 内含 DB、uploads、artifacts、飞书 OAuth token / 通知偏好等，均已在 .gitignore 中忽略。
DATA_DIR=./data

# --- 大模型（默认 Mock，不配 Key 也能跑通工程）---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MOCK=1
LLM_PRICE_PER_1K_CNY=0.02

# --- 检索（可选）---
TAVILY_API_KEY=
SEARCH_MOCK=1

# 本机资料库根目录（可选；留空则仅用上传）
LOCAL_WORKSPACE_ROOT=

# --- 飞书（默认 Mock）---
# 在飞书开放平台自建应用后填写 App ID / App Secret；勿把真实密钥提交到仓库。
FEISHU_MOCK=1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
# 可选：租户文档域名，例如 https://xxx.feishu.cn
FEISHU_DOC_BASE_URL=https://feishu.cn

# 1.23 飞书群通知（默认关闭；chat_id 等只放本机 .env / UI 偏好，勿提交）
FEISHU_NOTIFY_CHAT_ID=
FEISHU_NOTIFY_ON=off

# 1.24 用户 OAuth（user/refresh token 存 data/，勿写入本文件实值）
# 开放平台「安全设置 → 重定向 URL」须与此完全一致：
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8040/api/feishu/oauth/callback
# 建议 scopes（用户身份）：
FEISHU_OAUTH_SCOPES=offline_access docx:document drive:drive

COST_SOFT_LIMIT_CNY=5
AGENT_MAX_STEPS=12
# 任务列表：默认保留最近条数；超过天数的空闲任务自动归档
TASK_KEEP_RECENT=8
TASK_ARCHIVE_AFTER_DAYS=7
# 每个自动化保留最近 N 次跑次历史
SCHEDULE_RUN_KEEP=20
